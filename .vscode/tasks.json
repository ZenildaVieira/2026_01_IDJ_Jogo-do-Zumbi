{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar SDL2",
      "type": "shell",
      "command": "g++",
      "args": [
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/Game.cpp",
        "${workspaceFolder}/src/State.cpp",
        "${workspaceFolder}/src/Sprite.cpp",
        "${workspaceFolder}/src/Music.cpp",
        "-I${workspaceFolder}/include",
        "-IC:/SDL-2.32.10/include",
        "-LC:/SDL-2.32.10/lib",
        "-lmingw32",
        "-lSDL2main",
        "-lSDL2",
        "-lSDL2_image",
        "-lSDL2_ttf",
        "-lSDL2_mixer",
        "-o",
        "${workspaceFolder}/bin/programa.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}